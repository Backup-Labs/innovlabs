# AfriYouth Innovation Labs - Environment Configuration
# Copy this file to .env.local and fill in the values

# Base URL for metadata and canonical tags
NEXT_PUBLIC_SITE_URL=https://afriyouth.org

# Contact form submission provider: "local" (API route) or "formspree"
NEXT_PUBLIC_CONTACT_PROVIDER=local

# If using Formspree, set your form endpoint ID (e.g., https://formspree.io/f/xyz)
# FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# Support email recipient
CONTACT_RECIPIENT_EMAIL=collaborate@afriyouth.org
